
# ─── Supabase Configuration ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Shopify Integration ──────────────────────────────
# Found in Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_SHOP_NAME=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your-webhook-hmac-secret

# ─── Shiprocket Integration ───────────────────────────
SHIPROCKET_EMAIL=your-email@example.com
SHIPROCKET_SECRET_KEY=your-secure-password
SHIPROCKET_WEBHOOK_TOKEN=cureforever_shiprocket_sync_2026
HR_EMPLOYEE_DEFAULT_KEY=your-secure-default-password

# ─── WhatsApp Configuration (Local Bridge) ────────────
# The local bridge runs on PORT 3001
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_ADMIN_PHONE=+91XXXXXXXXXX

# ─── App & Sync Servers ───────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-char-secret
NEXT_PUBLIC_CHAT_URL=http://127.0.0.1:3002
SYNC_BASE_URL=http://127.0.0.1:3000
CHAT_PORT=3002
WA_PORT=3001

# ─── AI Integration (multi-provider fallback) ─────────
# Tried in order: gemini -> openai -> openrouter. Any subset may be set;
# a request only fails if every configured provider fails.
# Gemini (free tier): https://aistudio.google.com/
GEMINI_API_KEY=your_free_gemini_api_key_here
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter: https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=


# --- Internal route protection ---
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# Also accepted as the `x-cron-secret` header from server-to-server calls.
CRON_SECRET=
# Optional extra shared secret for the local chat/WhatsApp daemons
# (they fall back to SUPABASE_SERVICE_ROLE_KEY via `x-sync-secret`).
SYNC_SECRET=
# Set to "true" once every webhook secret above is configured in the host env.
# Unverified webhook payloads are then rejected instead of processed.
WEBHOOK_STRICT=false
# Secret the on-device call bridge (MacroDroid) must send as `x-sync-secret`
# when POSTing to /api/calls/webhook and /api/calls/upload.
# Falls back to SYNC_SECRET / SUPABASE_SERVICE_ROLE_KEY if unset.
BACKUP_SECRET=
